# ==============================================================================
# AuditPulse — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Java & Maven
# ------------------------------------------------------------------------------
target/
**/target/
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven artifacts & metadata
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# Node.js, Next.js & pnpm
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
dist/
.pnpm-store/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Explicitly keep the template
!.env.example

# ------------------------------------------------------------------------------
# Docker & Database Mounts
# ------------------------------------------------------------------------------
docker-data/
postgres-data/
*.rdb

# ------------------------------------------------------------------------------
# IDEs & System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
[Tt]humbs.db
ehthumbs.db

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.classpath
.project
.settings/

# Vim
*.swp
*.swo
*~
