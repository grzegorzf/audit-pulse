# ==============================================================================
# AuditPulse — Centralized Port & Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# Frontend UI port (Default: 3840)
AUDITPULSE_FRONTEND_PORT=3840

# Backend Reactive API & SSE port (Default: 8840)
AUDITPULSE_BACKEND_PORT=8840

# PostgreSQL 16 Database port (Default: 5842)
AUDITPULSE_POSTGRES_PORT=5842

# Public URL used by the browser to connect to the backend SSE streams
NEXT_PUBLIC_API_URL=http://localhost:8840
